# Local PostgreSQL example:
# DATABASE_URL="postgresql://user:password@localhost:5432/bethesda_db"

# Supabase Session Pooler example for Prisma local/dev servers:
# Use port 5432 so prepared statements are supported.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require&connection_limit=1"

# ProjectFlow database used to auto-sync cards, descriptions, assessment results, and checklists into reports and parent portals.
PROJECTFLOW_DATABASE_URL="postgresql://postgres.PROJECTFLOW_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"

# Supabase Transaction Pooler example for serverless deployments:
# DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"
