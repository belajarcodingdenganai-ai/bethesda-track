{
  "name": "bethesda-track",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:deploy": "prisma db push --schema ./prisma/schema.prisma",
    "postinstall": "prisma generate --schema ./prisma/schema.prisma",
    "seed": "npx tsx prisma/seed.ts",
    "build:android": "next build && npx cap sync",
    "android:dev": "npx cap sync android && npx cap open android",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@prisma/client": "5.22.0",
    "autoprefixer": "^10.5.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "geist": "^1.3.0",
    "html5-qrcode": "^2.3.8",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.379.0",
    "next": "^16.2.6",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^1.4.41",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.0",
    "postcss": "^8.5.15",
    "prisma": "5.22.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "esbuild@0.28.0": true,
    "prisma@5.22.0": true,
    "sharp@0.34.5": true,
    "@prisma/engines@5.22.0": true,
    "fsevents@2.3.3": true
  }
}
