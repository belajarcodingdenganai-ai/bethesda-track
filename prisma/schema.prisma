generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum UserRole {
  ADMIN
  TEACHER
  PARENT
  STUDENT
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  COMPLETED
}

enum PackageStatus {
  ACTIVE
  WARNING
  COMPLETED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum ProgramType {
  ABA
  SI
  SPEECH
  OT
  ACADEMIC
}

enum NotificationType {
  SESSION_ALERT
  PACKAGE_WARNING
  PACKAGE_COMPLETED
  ATTENDANCE_ALERT
}

// User & Authentication
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  role          UserRole
  profileImage  String?
  
  // Relations
  teacher       Teacher?
  parent        Parent?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([email])
}

// Admin/Teacher Model
model Teacher {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  teacherId     String    @unique
  division      String
  position      String
  phone         String?
  
  qrCode        String    @unique
  
  // Attendance tracking
  checkInTime   DateTime?
  checkOutTime  DateTime?
  totalHours    Float     @default(0)
  overtime      Float     @default(0)
  
  // Relations
  attendances   Attendance[]
  notifications Notification[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([teacherId])
}

// Parent Model
model Parent {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  phone         String?
  children      Student[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
}

// Student Model (Complete)
model Student {
  id            String          @id @default(cuid())
  
  // Identity
  registrationNo String         @unique
  name          String
  nickname      String?
  gender        String?
  dateOfBirth   DateTime?
  age           Int?
  
  // Contact
  address       String?
  parentPhone   String?
  parentEmail   String?
  school        String?
  
  // Medical/Educational
  diagnosis     String?
  profileImage  String?
  
  // System Fields
  qrCode        String          @unique
  status        StudentStatus   @default(ACTIVE)
  
  // Relations
  parentId      String?
  parent        Parent?         @relation(fields: [parentId], references: [id])
  
  programs      StudentProgram[]
  packages      TherapyPackage[]
  attendances   Attendance[]
  notifications Notification[]
  
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([registrationNo])
  @@index([parentId])
  @@index([status])
}

// Program Model
model Program {
  id            String        @id @default(cuid())
  name          ProgramType
  description   String?
  
  studentPrograms StudentProgram[]
  packages      TherapyPackage[]
  attendances   Attendance[]
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([name])
}

// Student-Program Junction
model StudentProgram {
  id            String    @id @default(cuid())
  
  studentId     String
  student       Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  programId     String
  program       Program   @relation(fields: [programId], references: [id], onDelete: Cascade)
  
  startDate     DateTime  @default(now())
  endDate       DateTime?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([studentId, programId])
  @@index([studentId])
  @@index([programId])
}

// Therapy Package Model
model TherapyPackage {
  id              String        @id @default(cuid())
  
  studentId       String
  student         Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  programId       String
  program         Program       @relation(fields: [programId], references: [id])
  
  // Package details
  frequency       Int           // 2 = 2x per week, 3 = 3x per week
  totalSessions   Int
  usedSessions    Int           @default(0)
  
  // Status tracking
  status          PackageStatus @default(ACTIVE)
  startDate       DateTime      @default(now())
  endDate         DateTime?
  
  // Alert thresholds
  warningThreshold Int          @default(1)
  
  // Relations
  attendances     Attendance[]
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([studentId])
  @@index([programId])
  @@index([status])
}

// Attendance Record
model Attendance {
  id            String          @id @default(cuid())
  
  studentId     String
  student       Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  teacherId     String
  teacher       Teacher         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  
  programId     String
  program       Program         @relation(fields: [programId], references: [id])
  
  // Time tracking
  checkIn       DateTime        @default(now())
  checkOut      DateTime?
  duration      Float?          // in minutes
  
  // Location
  room          String?
  
  // Status
  status        AttendanceStatus @default(PRESENT)
  
  // Package tracking
  packageId     String
  package       TherapyPackage  @relation(fields: [packageId], references: [id])
  
  // QR scan reference
  qrCodeScanned String?
  
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([studentId])
  @@index([teacherId])
  @@index([checkIn])
  @@index([status])
}

// Notification Model
model Notification {
  id            String          @id @default(cuid())
  
  type          NotificationType
  title         String
  message       String
  
  studentId     String?
  student       Student?        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  teacherId     String?
  teacher       Teacher?        @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  
  packageId     String?
  
  // Delivery
  isRead        Boolean         @default(false)
  readAt        DateTime?
  
  // WhatsApp tracking
  whatsappSent  Boolean         @default(false)
  whatsappSentAt DateTime?
  whatsappId    String?
  
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([studentId])
  @@index([teacherId])
  @@index([type])
  @@index([isRead])
}

// Analytics/Reporting Model
model DailyReport {
  id            String    @id @default(cuid())
  
  date          DateTime  @unique
  
  totalStudents Int       @default(0)
  totalAttendance Int      @default(0)
  totalTeachers Int       @default(0)
  totalSessions Int       @default(0)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
